DISCORD_BOT_TOKEN=your_discord_bot_token_here
BOT_PREFIX=!
LOG_LEVEL=INFO
BOT_BRAND_NAME=KSC Gaming
BOT_MASCOT_PATH=docs/assets/ksc-mascot.png
SYNC_BRAND_AVATARS=true
DISCORD_GUILD_ID=123456789012345678
PLAYER_REFRESH_SECONDS=30
DJ_CROSSFADE_SECONDS=6
DJ_PHRASE_BARS=4
DJ_VOCAL_THRESHOLD=0.72
DJ_ENERGY_DELTA_THRESHOLD=0.42
DJ_ANALYSIS_SECONDS=75
DJ_ANALYSIS_ENABLED=true
DJ_ANALYSIS_SAMPLE_RATE=11025
DJ_ANALYSIS_CONCURRENCY=2
DJ_STRUCTURE_ENABLED=true
DJ_STRUCTURE_MAX_SECONDS=360
DJ_SMART_REORDER_WINDOW=4
DJ_SMART_REORDER_MIN_GAIN=0.08
DJ_MIN_PLAYBACK_RATIO=0.90
DJ_EARLY_EOF_TOLERANCE_SECONDS=15
MUSIC_DATABASE_PATH=data/music.db
COMMUNITY_DATABASE_PATH=data/community.db

# Optional: mirrors the current track to a dedicated Discord webhook channel.
DISCORD_NOW_PLAYING_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
NOW_PLAYING_WEBHOOK_NAME=KSC Music
NOW_PLAYING_WEBHOOK_GUILD_ID=123456789012345678
NOW_PLAYING_WEBHOOK_REFRESH_SECONDS=30

# Optional: keeps a server introduction, guide, and rules message at the bottom of a channel.
DISCORD_SERVER_GUIDE_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
SERVER_GUIDE_WEBHOOK_NAME=KSC Gaming
SERVER_GUIDE_WEBHOOK_GUILD_ID=123456789012345678
SERVER_GUIDE_BUMP_DELAY_SECONDS=8

# Optional: path to FFmpeg when it is not available in PATH.
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe

# Optional: cookies exported in Netscape format for restricted YouTube videos.
# YTDLP_COOKIE_FILE=./cookies.txt
